[Unit]
Description=Racion meal plan
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=ration
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/ration -addr 0.0.0.0:8080 -db /var/lib/ration/ration.db
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
